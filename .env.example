# Copy to .env (make env). Every variable is documented in internal/platform/config/config.go.
APP_ENV=local
LOG_LEVEL=debug

DB_URL=postgres://app:app@localhost:5432/app?sslmode=disable
REDIS_ADDR=localhost:6379
KAFKA_BROKERS=localhost:9092

# Tracing to the local Jaeger (OTLP gRPC). Sample everything locally.
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
OTEL_TRACE_SAMPLE_RATIO=1

# Generous limits for local load testing; tune per environment.
RATE_LIMIT_RPS=1000
RATE_LIMIT_BURST=2000
